{
  "name": "nossa-politica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "velite build && next dev",
    "build": "velite build && tsx scripts/og/gerar.tsx && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "velite build && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "etl:camara": "tsx etl/camara/index.ts",
    "etl:validar": "tsx etl/validar.ts",
    "etl:senado": "tsx etl/senado/index.ts",
    "etl:emendas": "tsx etl/emendas/index.ts",
    "etl:tse": "tsx etl/tse/index.ts",
    "etl:pessoas": "tsx etl/pessoas/index.ts",
    "dados:baixar": "rm -rf dados && git clone --quiet --depth 1 --branch dados https://github.com/Nossa-Politica/nossa-politica.git dados && rm -rf dados/.git",
    "conteudo": "velite dev",
    "social:publicar": "tsx scripts/social/publish.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "1.20.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "minisearch": "^7.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "jpeg-js": "0.4.4",
    "jsdom": "^30.1.2",
    "rehype-slug": "6.0.0",
    "satori": "^0.49.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "velite": "^0.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  }
}
